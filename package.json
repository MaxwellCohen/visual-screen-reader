{
  "name": "visual-screen-reader",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:firefox": "vite --mode firefox",
    "build": "vite build",
    "build:firefox": "vite build --mode firefox",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "biome lint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@crxjs/vite-plugin": "^2.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.1.4",
    "@types/node": "^24.12.3",
    "happy-dom": "^20.10.2",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
